# Cue Point — environment
#
# Full-stack app on PostgreSQL (raw SQL, no ORM). Copy to .env, point
# DATABASE_URL at your Postgres, then:
#
#   npm run db:setup     # apply db/schema.sql + insert business config
#                        # (membership tiers, achievements, rewards, the venue)
#   npm run dev
#
# NO demo/activity data is inserted. Players, matches, tournaments and
# promotions are all created through the app: register the FIRST account at
# /account (it becomes the admin), then use the staff console at /admin.
#
# Local example (Postgres running on your machine):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cuepoint"
#
# Hosted examples:
#   Neon:     postgresql://user:pass@ep-xxx.aws.neon.tech/cuepoint?sslmode=require
#   Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres

# Secret used to sign session cookies. Set a long random string in production.
# Falls back to DATABASE_URL locally so sessions survive dev restarts.
SESSION_SECRET=

# Optional: lets scripts / integrations perform staff actions via an
# `x-staff-key` header without a logged-in staff account. Signed-in staff
# and admin roles never need this.
STAFF_KEY=

# Optional: gate GET /api/bookings and the bookings tab with an x-admin-key.
ADMIN_KEY=
